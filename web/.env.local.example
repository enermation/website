# ─── RAG / Assistant ────────────────────────────────────────────────────────────

# Voyage AI — embeddings + reranking
VOYAGE_API_KEY=

# Upstash Vector — vector database
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis — rate-limit backing store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for admin reindex endpoint
RAG_ADMIN_SECRET=

# Chat provider: "anthropic" (default) or "groq"
CHAT_PROVIDER=anthropic

# Model ID passed to the provider (defaults per provider below)
# anthropic: claude-haiku-4-5
# groq: meta-llama/llama-4-scout-17b-16e-instruct
CHAT_MODEL_ID=

# API key for the selected chat provider
ANTHROPIC_API_KEY=
GROQ_API_KEY=
